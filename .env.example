# Nebius Token Factory (required for server-key mode)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Optional model overrides. These defaults are NVIDIA Nemotron model IDs.
NEBIUS_MODEL_NANO=nvidia/Llama-3.1-Nemotron-Nano-8B-v1
NEBIUS_MODEL_SUPER=nvidia/Llama-3.1-Nemotron-Super-49B-v1
NEBIUS_MODEL_ULTRA=nvidia/Llama-3.1-Nemotron-Ultra-253B-v1
# Comma-separated fallback model IDs for each tier.
NEBIUS_FALLBACK_NANO=
NEBIUS_FALLBACK_SUPER=
NEBIUS_FALLBACK_ULTRA=

# Tavily Search API (required for server-key mode)
TAVILY_API_KEY=

# Optional request timeout in milliseconds (default: 45000)
AGENT_REQUEST_TIMEOUT_MS=45000
